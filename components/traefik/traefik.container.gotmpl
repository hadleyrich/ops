[Unit]
Description=Traefik reverse proxy
After=http.socket https.socket
Requires=http.socket https.socket

[Install]
# Start by default on boot
WantedBy=multi-user.target default.target

[Service]
Sockets=http.socket https.socket
Restart=on-failure
RestartSec=5s

[Container]
ContainerName=traefik
Environment=CF_API_EMAIL=hads@nice.net.nz CF_API_KEY={{.cf_api_key}}
Exec=--providers.docker --providers.docker.exposedbydefault=false --providers.docker.network=ingress --providers.docker.endpoint=unix:///var/run/podman/podman.sock --providers.file.directory=/etc/traefik/conf.d --providers.file.watch=true --entrypoints.http.address=:80 --entrypoints.http.reusePort=true --entryPoints.http.asDefault=true --entrypoints.http.http.redirections.entryPoint.to=https --entrypoints.http.http.redirections.entryPoint.scheme=https --entrypoints.https.address=:443 --entrypoints.https.http.tls=true' --entrypoints.https.http3 '--entrypoints.https.reusePort=true --entryPoints.https.asDefault=true --entrypoints.https.http.tls.certResolver=le --entryPoints.https.transport.lifeCycle.requestAcceptGraceTimeout=5 --certificatesresolvers.le.acme.email=domains@nice.nz --certificatesresolvers.le.acme.storage=/etc/traefik/acme.json --certificatesresolvers.le.acme.dnschallenge=true --certificatesresolvers.le.acme.dnschallenge.provider=cloudflare --log.level=INFO' --accesslog --api '--entryPoints.metrics.address=:8082 --metrics.prometheus=true --metrics.prometheus.entryPoint=metrics --metrics.prometheus.addEntryPointsLabels=true --metrics.prometheus.addrouterslabels=true --metrics.prometheus.addServicesLabels=true --experimental.plugins.traefik-oidc-auth.modulename=github.com/sevensolutions/traefik-oidc-auth --experimental.plugins.traefik-oidc-auth.version=v0.19.0
HostName=traefik
Image=docker.io/traefik:{{.containerTag}}
Label=traefik.enable=true traefik.http.routers.public-https.rule=Host(`{{.traefik_domain}}`) traefik.http.routers.public-https.middlewares=traefik-oidc traefik.http.routers.public-https.service=api@internal traefik.http.services.public.loadbalancer.server.port=8080 traefik.tls.stores.default.defaultgeneratedcert.resolver=le traefik.tls.stores.default.defaultgeneratedcert.domain.main=nice.nz traefik.tls.stores.default.defaultgeneratedcert.domain.sans=*.nice.nz traefik.http.middlewares.traefik-oidc.plugin.traefik-oidc-auth.Provider.Url=https://id.nice.nz traefik.http.middlewares.traefik-oidc.plugin.traefik-oidc-auth.Provider.ClientId=ff0308f5-4842-4c57-8c2d-d40e34f1b331 traefik.http.middlewares.traefik-oidc.plugin.traefik-oidc-auth.Provider.ClientSecret=${OIDC_CLIENT_SECRET} traefik.http.middlewares.traefik-oidc.plugin.traefik-oidc-auth.Provider.TokenValidation=IdToken traefik.http.middlewares.traefik-oidc.plugin.traefik-oidc-auth.Secret=${OIDC_PLUGIN_SECRET}
Network=ingress
PodmanArgs=--userns=keep-id
PublishPort=80:80
PublishPort=443:443
Volume=/srv/podman/traefik/config:/etc/traefik
Volume=/srv/podman/traefik/plugins-storage:/plugins-storage
Volume=/var/run/user/1000/podman:/var/run/podman/
